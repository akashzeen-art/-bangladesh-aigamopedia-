{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Skip install'",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": ".vercel/output/static",
  "redirects": [
    { "source": "/", "destination": "/bn/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/bn", "destination": "/index.html" },
    { "source": "/bn/", "destination": "/index.html" },
    { "source": "/bn/index.html", "destination": "/index.html" },
    { "source": "/bn/moreGames.html", "destination": "/moreGames.html" },
    { "source": "/bn/myAccount.html", "destination": "/myAccount.html" },
    { "source": "/bn/termsAndConditions.html", "destination": "/termsAndConditions.html" },
    { "source": "/bn/(.*)", "destination": "/$1" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/", "destination": "/index.html" },
    { "source": "/en/index.html", "destination": "/index.html" },
    { "source": "/en/moreGames.html", "destination": "/moreGames.html" },
    { "source": "/en/myAccount.html", "destination": "/myAccount.html" },
    { "source": "/en/termsAndConditions.html", "destination": "/termsAndConditions.html" },
    { "source": "/en/(.*)", "destination": "/$1" }
  ]
}
